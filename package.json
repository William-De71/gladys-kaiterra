{
  "name": "gladys-kaiterra",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration for Kaiterra air quality monitors (Sensedge, Sensedge Mini, Laser Egg) through the official Kaiterra API: AQI, PM2.5, PM10, CO2, TVOC, temperature, humidity, scene triggers and dashboard widgets.",
  "homepage": "https://github.com/William-De71/gladys-kaiterra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-kaiterra.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "kaiterra",
    "sensedge",
    "laser-egg",
    "air-quality",
    "co2",
    "tvoc",
    "pm25",
    "home-automation"
  ]
}
